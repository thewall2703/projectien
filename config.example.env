# Copy to .env and adjust if needed.
# Do not commit real secrets.

OUTPUT_DIR=./output/transcripts
TEMP_DIR=./.tmp/audio
STREAM_WORKERS=2
MODEL_NAME=mlx-community/parakeet-tdt-0.6b-v3
GOOGLE_CREDENTIALS=./credentials.json
GOOGLE_TOKEN=./.token.json

# Deadline notes (not enforced by the app):
# - Bottleneck is usually Drive streaming bandwidth, not Mac ASR.
# - At ~300 Mbps, every ~100 GB of source video needs ~45 minutes.
# - Local Parakeet MLX on M-series typically finishes 21–29 audio hours in ~20–45 minutes.
# - Target cost: ₹0 (local-only; no paid API / Runpod required).

